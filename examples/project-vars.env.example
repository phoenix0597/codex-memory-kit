# Пример значений; скрипты не исполняют и не подхватывают этот файл автоматически.
# POSIX/WSL
HOME_DIR=/home/example
GLOBAL_MEMORY_DIR=/home/example/.agents/memories
KIT_ROOT=/home/example/src/codex-memory-kit
CODEX_DIR=/home/example/.codex
DSH_DIR=/home/example/.dsh
REPO_ROOT=/home/example/path/to/project
PROJECT_NAME=my-project

# Windows: те же роли, нативные пути; значения передаются аргументами скрипта.
# HOME_DIR=C:\Users\Example
# GLOBAL_MEMORY_DIR=C:\Users\Example\.agents\memories
# KIT_ROOT=C:\Users\Example\src\codex-memory-kit
# CODEX_DIR=C:\Users\Example\.codex
# DSH_DIR=C:\Users\Example\.dsh
# REPO_ROOT=C:\Users\Example\path\to\project
# PROJECT_NAME=my-project
