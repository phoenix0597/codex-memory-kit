# POSIX/WSL
HOME_DIR=/home/example
CODEX_DIR=/home/example/.codex
GLOBAL_MEMORY_DIR=/home/example/.codex/memories
REPO_ROOT=/home/example/path/to/project
PROJECT_NAME=my-project

# Windows PowerShell: используйте те же имена переменных, если нужен Windows-вариант.
# HOME_DIR=C:\Users\Example
# CODEX_DIR=C:\Users\Example\.codex
# GLOBAL_MEMORY_DIR=C:\Users\Example\.codex\memories
# REPO_ROOT=C:\Users\Example\path\to\project
# PROJECT_NAME=my-project
